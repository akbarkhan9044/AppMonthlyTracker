# Supabase (public client config — safe to expose; RLS protects the data).
# Get these from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional: base URL for the Netlify functions when the frontend is NOT served
# from Netlify (e.g. a separately hosted build). Leave empty for same-origin.
# VITE_API_BASE=https://trackerakbar.netlify.app
